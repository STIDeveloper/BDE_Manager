# ============================================================
# BDE Manager — configuration du backend collaboratif (facultatif)
# ============================================================
# Sans ces variables, l'application fonctionne en mode local, et le projet
# Supabase peut aussi être renseigné depuis l'écran « Équipe & accès ».
# Copie ce fichier en .env.local (non versionné) ou définis les variables
# dans Vercel › Settings › Environment Variables.
#
# ⚠️ Uniquement la clé PUBLIQUE (« anon public » ou « sb_publishable_… »).
# Ne mets JAMAIS la clé service_role / sb_secret_… dans l'application.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL publique de l'application, imprimée dans les QR codes de vérification
# des documents (facultatif ; par défaut : l'adresse courante).
VITE_PUBLIC_APP_URL=
